import React, { useEffect, useState } from 'react';
import { useSelector } from 'react-redux';
import { RootState } from '../store';
import Sidebar from '../components/Sidebar';
import api from '../services/api';
import '../styles/Dashboard.css';

interface Description {
  texto: string;
  color: string | null;
}

interface CalendarEvent {
  id: number;
  titulo: string;
  descripcion: string; // JSON string de array de Description
  fechaInicio: string;
  duracion: string;
  completado?: boolean;
  createdBy?: number;
}

const COLOR_CODES = [
  { name: 'Sin Color', hex: null, class: 'sincolor' },
  { name: 'Mantenimiento', hex: '#FFFF00', class: 'amarillo' },
  { name: 'Actividades Villita', hex: '#22c55e', class: 'verde' },
  { name: 'Mantenimiento Correctivo', hex: '#ef4444', class: 'rojo' },
  { name: 'Azul', hex: '#3b82f6', class: 'azul' },
  { name: 'Púrpura', hex: '#8b5cf6', class: 'purpura' },
  { name: 'Rosa', hex: '#ec4899', class: 'rosa' },
];

export const Calendar: React.FC = () => {
  const user = useSelector((state: RootState) => state.auth.user);
  const [events, setEvents] = useState<CalendarEvent[]>([]);
  const [currentDate, setCurrentDate] = useState(new Date());
  const [showCreateModal, setShowCreateModal] = useState(false);
  const [showEditModal, setShowEditModal] = useState(false);
  const [selectedDate, setSelectedDate] = useState<string>('');
  const [selectedEvent, setSelectedEvent] = useState<CalendarEvent | null>(null);
  
  const [newEvent, setNewEvent] = useState({ 
    titulo: '', 
    descripciones: [] as Description[],
    duracion: '60', 
  });

  const [editEvent, setEditEvent] = useState({
    titulo: '',
    descripciones: [] as Description[],
    duracion: '60',
  });

  const canEdit = ['jefe', 'sistemas'].includes(user?.rol || '');

  useEffect(() => {
    fetchEvents();
  }, []);

  const fetchEvents = async () => {
    try {
      const response = await api.get('/calendar');
      console.log('Events loaded:', response.data);
      setEvents(response.data);
    } catch (error) {
      console.error('Error fetching events:', error);
    }
  };

  const getDaysInMonth = (date: Date) => {
    return new Date(date.getFullYear(), date.getMonth() + 1, 0).getDate();
  };

  const getFirstDayOfMonth = (date: Date) => {
    return new Date(date.getFullYear(), date.getMonth(), 1).getDay();
  };

  const formatDateWithDay = (dateStr: string) => {
    if (!dateStr) return 'Fecha inválida';
    
    // If dateStr already includes time, use it as-is; otherwise add T00:00:00
    const dateStrFormatted = dateStr.includes('T') ? dateStr : dateStr + 'T00:00:00';
    const date = new Date(dateStrFormatted);
    
    // Validate date
    if (isNaN(date.getTime())) {
      return 'Fecha inválida';
    }
    
    const dayName = date.toLocaleDateString('es-MX', { weekday: 'long' });
    const dateFormatted = date.toLocaleDateString('es-MX', { day: 'numeric', month: 'long', year: 'numeric' });
    return `${dayName.charAt(0).toUpperCase() + dayName.slice(1)} ${dateFormatted}`;
  };

  const parseDescripciones = (descripcionStr: string | any): Description[] => {
    try {
      if (typeof descripcionStr === 'string') {
        return JSON.parse(descripcionStr || '[]');
      }
      return Array.isArray(descripcionStr) ? descripcionStr : [];
    } catch {
      return [];
    }
  };

  const handlePrevMonth = () => {
    setCurrentDate(new Date(currentDate.getFullYear(), currentDate.getMonth() - 1));
  };

  const handleNextMonth = () => {
    setCurrentDate(new Date(currentDate.getFullYear(), currentDate.getMonth() + 1));
  };

  const handleDateClick = (day: number) => {
    if (!canEdit) return;
    const dateStr = new Date(currentDate.getFullYear(), currentDate.getMonth(), day)
      .toISOString()
      .split('T')[0];
    setSelectedDate(dateStr);
    setNewEvent({ titulo: '', descripciones: [], duracion: '60' });
    setShowCreateModal(true);
  };

  const handleAddDescription = () => {
    setNewEvent({
      ...newEvent,
      descripciones: [...newEvent.descripciones, { texto: '', color: null }]
    });
  };

  const handleRemoveDescription = (index: number) => {
    setNewEvent({
      ...newEvent,
      descripciones: newEvent.descripciones.filter((_, i) => i !== index)
    });
  };

  const handleUpdateDescription = (index: number, texto: string, color: string | null) => {
    const newDescs = [...newEvent.descripciones];
    newDescs[index] = { texto, color };
    setNewEvent({ ...newEvent, descripciones: newDescs });
  };

  const handleAddEvent = async () => {
    try {
      await api.post('/calendar', {
        titulo: newEvent.titulo || '[Sin título]',
        descripcion: JSON.stringify(newEvent.descripciones),
        fechaInicio: selectedDate,
        duracion: newEvent.duracion,
      });
      
      await fetchEvents();
      setShowCreateModal(false);
      setNewEvent({ titulo: '', descripciones: [], duracion: '60' });
    } catch (error: any) {
      console.error('Error adding event:', error);
      alert('Error al guardar el evento: ' + (error.response?.data?.message || error.message));
    }
  };

  const handleEditDescription = (index: number, texto: string, color: string | null) => {
    const newDescs = [...editEvent.descripciones];
    newDescs[index] = { texto, color };
    setEditEvent({ ...editEvent, descripciones: newDescs });
  };

  const handleRemoveEditDescription = (index: number) => {
    setEditEvent({
      ...editEvent,
      descripciones: editEvent.descripciones.filter((_, i) => i !== index)
    });
  };

  const handleAddEditDescription = () => {
    setEditEvent({
      ...editEvent,
      descripciones: [...editEvent.descripciones, { texto: '', color: null }]
    });
  };

  const handleEditEvent = async () => {
    if (!selectedEvent) return;
    try {
      await api.put(`/calendar/${selectedEvent.id}`, {
        titulo: editEvent.titulo || '[Sin título]',
        descripcion: JSON.stringify(editEvent.descripciones),
        duracion: editEvent.duracion,
      });
      
      await fetchEvents();
      setShowEditModal(false);
      setSelectedEvent(null);
    } catch (error: any) {
      console.error('Error updating event:', error);
      alert('Error al actualizar el evento: ' + (error.response?.data?.message || error.message));
    }
  };

  const handleDeleteEvent = async (eventId: number) => {
    if (confirm('¿Estás seguro de que quieres eliminar este evento?')) {
      try {
        await api.delete(`/calendar/${eventId}`);
        await fetchEvents();
        setShowEditModal(false);
        setSelectedEvent(null);
      } catch (error) {
        console.error('Error deleting event:', error);
      }
    }
  };

  const handleToggleComplete = async (eventId: number, currentStatus: boolean) => {
    try {
      await api.patch(`/calendar/${eventId}/complete`, { completed: !currentStatus });
      await fetchEvents();
    } catch (error: any) {
      console.error('Error toggling completion:', error);
    }
  };

  const getEventsForDay = (day: number): CalendarEvent[] => {
    const dateStr = new Date(currentDate.getFullYear(), currentDate.getMonth(), day)
      .toISOString()
      .split('T')[0];
    return events.filter(e => e.fechaInicio === dateStr);
  };

  const getColorName = (hex: string | null) => {
    if (!hex) return 'Sin Color';
    const color = COLOR_CODES.find(c => c.hex === hex);
    return color?.name || hex;
  };

  const daysInMonth = getDaysInMonth(currentDate);
  const firstDay = getFirstDayOfMonth(currentDate);
  const days = Array.from({ length: daysInMonth }, (_, i) => i + 1);
  const emptyDays = Array.from({ length: firstDay }, (_, i) => i);

  const monthName = currentDate.toLocaleString('es-MX', { month: 'long', year: 'numeric' });

  return (
    <div className="dashboard-layout">
      <Sidebar />
      <main className="dashboard-main">
        <div className="dashboard-container">
          <div className="dashboard-header">
            <h1>📅 Calendario de Trabajos</h1>
            <p className="subtitle">Planifica y gestiona tus actividades</p>

          {/* ARCHIVE TABS */}
          <div style={{ marginBottom: '1.5rem', display: 'flex', gap: '1rem', borderBottom: '2px solid #e2e8f0', paddingBottom: '1rem' }}>
            <button
              onClick={() => setShowArchive(false)}
              style={{
                background: !showArchive ? '#0066cc' : '#e2e8f0',
                color: !showArchive ? 'white' : '#475569',
                border: 'none',
                padding: '0.75rem 1.5rem',
                borderRadius: '8px',
                cursor: 'pointer',
                fontWeight: 'bold',
                fontSize: '0.95rem',
              }}
            >
              📆 Semana Actual
            </button>
            <button
              onClick={() => setShowArchive(true)}
              style={{
                background: showArchive ? '#0066cc' : '#e2e8f0',
                color: showArchive ? 'white' : '#475569',
                border: 'none',
                padding: '0.75rem 1.5rem',
                borderRadius: '8px',
                cursor: 'pointer',
                fontWeight: 'bold',
                fontSize: '0.95rem',
              }}
            >          <div style={{ background: 'white', borderRadius: '16px', padding: '2rem', boxShadow: '0 4px 16px rgba(0,0,0,0.08)', marginBottom: '2rem' }}>
            <h2 style={{ fontSize: '1.5rem', fontWeight: 'bold', color: '#1a365d', marginBottom: '2rem' }}>
          </div>

          {/* CALENDAR SECTION */}
          <div style={{ background: 'white', borderRadius: '16px', padding: '2rem', boxShadow: '0 4px 16px rgba(0,0,0,0.08)', marginBottom: '2rem' }}>
            <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: '2rem' }}>
              <h2 style={{ fontSize: '1.5rem', fontWeight: 'bold', color: '#1a365d', margin: 0 }}>
                {monthName.toUpperCase()}
              </h2>
              <div style={{ display: 'flex', gap: '1rem' }}>
                <button
                  onClick={handlePrevMonth}
                  style={{
                    background: '#0066cc',
                    color: 'white',
                    border: 'none',
                    padding: '0.75rem 1.5rem',
                    borderRadius: '8px',
                    fontWeight: 'bold',
                    cursor: 'pointer',
                  }}
                >
                  ← Anterior
                </button>
                <button
                  onClick={handleNextMonth}
                  style={{
                    background: '#0066cc',
                    color: 'white',
                    border: 'none',
                    padding: '0.75rem 1.5rem',
                    borderRadius: '8px',
                    fontWeight: 'bold',
                    cursor: 'pointer',
                  }}
                >
                  Siguiente →
                </button>
              </div>
            </div>

            <div style={{ display: 'grid', gridTemplateColumns: 'repeat(7, 1fr)', gap: '0.5rem', marginBottom: '0.5rem' }}>
              {['Dom', 'Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb'].map(day => (
                <div
                  key={day}
                  style={{
                    textAlign: 'center',
                    fontWeight: 'bold',
                    color: '#0066cc',
                    padding: '0.75rem',
                    background: '#f0f4f8',
                    borderRadius: '8px',
                  }}
                >
                  {day}
                </div>
              ))}
            </div>

            <div style={{ display: 'grid', gridTemplateColumns: 'repeat(7, 1fr)', gap: '0.5rem' }}>
              {emptyDays.map((_, i) => (
                <div key={`empty-${i}`} style={{ background: '#f9fafb', minHeight: '140px', borderRadius: '8px' }}></div>
              ))}

              {days.map(day => {
                const dayEvents = getEventsForDay(day);
                const isToday =
                  day === new Date().getDate() &&
                  currentDate.getMonth() === new Date().getMonth() &&
                  currentDate.getFullYear() === new Date().getFullYear();

                return (
                  <div
                    key={day}
                    data-calendar-day={day}
                    style={{
                      minHeight: '140px',
                      border: isToday ? '3px solid #0066cc' : '1px solid #e2e8f0',
                      borderRadius: '8px',
                      padding: '0.75rem',
                      background: isToday ? '#f0f7ff' : 'white',
                      cursor: canEdit ? 'pointer' : 'default',
                      transition: 'all 0.3s',
                      position: 'relative',
                      display: 'flex',
                      flexDirection: 'column',
                    }}
                    onClick={() => handleDateClick(day)}
                    onMouseEnter={(e) => {
                      if (canEdit) {
                        e.currentTarget.style.background = '#f8fafc';
                        e.currentTarget.style.boxShadow = '0 4px 12px rgba(0,102,204,0.1)';
                      }
                    }}
                    onMouseLeave={(e) => {
                      e.currentTarget.style.background = isToday ? '#f0f7ff' : 'white';
                      e.currentTarget.style.boxShadow = 'none';
                    }}
                  >
                    <div style={{ fontWeight: 'bold', fontSize: '1rem', color: '#1a365d', marginBottom: '0.5rem' }}>
                      {day}
                    </div>

                    <div style={{ display: 'flex', flexDirection: 'column', gap: '0.3rem', flex: 1, overflowY: 'auto' }}>
                      {dayEvents.map((event, idx) => {
                        const descs = parseDescripciones(event.descripcion);
                        return (
                          <div
                            key={event.id}
                            onClick={(e) => {
                              e.stopPropagation();
                              if (canEdit) {
                                setSelectedEvent(event);
                                setEditEvent({
                                  titulo: event.titulo,
                                  descripciones: descs,
                                  duracion: event.duracion,
                                });
                                setShowEditModal(true);
                              }
                            }}
                            style={{
                              cursor: canEdit ? 'pointer' : 'default',
                              transition: 'all 0.2s',
                            }}
                            onMouseEnter={(e) => {
                              if (canEdit) {
                                e.currentTarget.style.transform = 'scale(1.02)';
                              }
                            }}
                            onMouseLeave={(e) => {
                              e.currentTarget.style.transform = 'scale(1)';
                            }}
                          >
                            <div style={{ fontSize: '0.7rem', fontWeight: 'bold', color: '#1a365d', marginBottom: '0.2rem' }}>
                              📌 {event.titulo}
                            </div>
                            {descs.map((desc, descIdx) => (
                              <div
                                key={descIdx}
                                style={{
                                  background: desc.color || '#e2e8f0',
                                  color: desc.color === '#FFFF00' || !desc.color ? '#000' : desc.color === '#22c55e' ? '#000' : 'white',
                                  padding: '0.3rem 0.5rem',
                                  borderRadius: '3px',
                                  fontSize: '0.65rem',
                                  fontWeight: '600',
                                  border: '0.5px solid rgba(0,0,0,0.1)',
                                  wordBreak: 'break-word',
                                  lineHeight: '1.1',
                                  whiteSpace: 'nowrap',
                                  overflow: 'hidden',
                                  textOverflow: 'ellipsis',
                                }}
                                title={desc.texto}
                              >
                                {desc.texto}
                              </div>
                            ))}
                          </div>
                        );
                      })}
                    </div>

                    {canEdit && dayEvents.length < 5 && (
                      <div style={{ 
                        marginTop: 'auto', 
                        fontSize: '0.65rem', 
                        color: '#94a3b8',
                        opacity: 0.5,
                        paddingTop: '0.4rem',
                        borderTop: '1px dashed #e2e8f0'
                      }}>
                        + Agregar
                      </div>
                    )}
                  </div>
                );
              })}
            </div>

            <div style={{ marginTop: '2rem', padding: '1rem', background: '#f0f4f8', borderRadius: '8px' }}>
              <p style={{ margin: '0 0 0.75rem 0', fontWeight: 'bold', color: '#1a365d' }}>Códigos de Color (Opcional):</p>
              <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(200px, 1fr))', gap: '1rem' }}>
                {COLOR_CODES.map(code => (
                  <div key={code.hex || 'none'} style={{ display: 'flex', alignItems: 'center', gap: '0.5rem' }}>
                    <div
                      style={{
                        width: '24px',
                        height: '24px',
                        background: code.hex || '#e2e8f0',
                        borderRadius: '4px',
                        border: code.hex === '#FFFF00' || !code.hex ? '1px solid #000' : 'none',
                      }}
                    ></div>
                    <span style={{ color: '#475569', fontSize: '0.9rem' }}>{code.name}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>

          {/* TABLA EXCEL STYLE */}
          <div style={{ background: 'white', borderRadius: '16px', padding: '2rem', boxShadow: '0 4px 16px rgba(0,0,0,0.08)' }}>
            <h2 style={{ margin: '0 0 1.5rem 0', color: '#1a365d', fontSize: '1.3rem', fontWeight: 'bold' }}>
              📊 Todas las Actividades
            </h2>

            <div style={{ overflowX: 'auto' }}>
              <table style={{
                width: '100%',
                borderCollapse: 'collapse',
                fontSize: '0.9rem',
              }}>
                <thead>
                  <tr style={{ background: '#0066cc', color: 'white' }}>
                    <th style={{ padding: '1rem', textAlign: 'left', fontWeight: 'bold', borderBottom: '2px solid #0066cc' }}>📅 Día y Fecha</th>
                    <th style={{ padding: '1rem', textAlign: 'left', fontWeight: 'bold', borderBottom: '2px solid #0066cc' }}>📝 Título</th>
                    <th style={{ padding: '1rem', textAlign: 'left', fontWeight: 'bold', borderBottom: '2px solid #0066cc' }}>📌 Descripciones</th>
                    <th style={{ padding: '1rem', textAlign: 'center', fontWeight: 'bold', borderBottom: '2px solid #0066cc' }}>⏱️ Duración</th>
                    <th style={{ padding: '1rem', textAlign: 'center', fontWeight: 'bold', borderBottom: '2px solid #0066cc' }}>✅ Estado</th>
                    {canEdit && <th style={{ padding: '1rem', textAlign: 'center', fontWeight: 'bold', borderBottom: '2px solid #0066cc' }}>⚙️ Acciones</th>}
                  </tr>
                </thead>
                <tbody>
                  {events.length === 0 ? (
                    <tr>
                      <td colSpan={canEdit ?  6 :  5} style={{ padding: '2rem', textAlign: 'center', color: '#94a3b8' }}>
                        No hay actividades guardadas
                      </td>
                    </tr>
                    events.map((event, index) => {
                      const descs = parseDescripciones(event.descripcion);
                      return (
                        <tr
                          key={event.id}
                          style={{
                            background: index % 2 === 0 ? '#f9fafb' : 'white',
                            borderBottom: '1px solid #e2e8f0',
                            transition: 'background 0.2s',
                          }}
                          onMouseEnter={(e) => {
                            e.currentTarget.style.background = '#f0f7ff';
                          }}
                          onMouseLeave={(e) => {
                            e.currentTarget.style.background = index % 2 === 0 ? '#f9fafb' : 'white';
                          }}
                        >
                          <td style={{ padding: '1rem', color: '#475569', fontWeight: '600' }}>
                            {formatDateWithDay(event.fechaInicio)}
                          </td>
                          <td style={{ 
                            padding: '1rem', 
                            fontWeight: 'bold',
                            color: '#1a365d',
                            maxWidth: '200px',
                            wordBreak: 'break-word',
                          }}>
                            {event.titulo}
                          </td>
                          <td style={{ 
                            padding: '1rem', 
                            color: '#64748b',
                            maxWidth: '400px',
                            wordBreak: 'break-word',
                          }}>
                            {descs.length === 0 ? (
                              <span style={{ color: '#94a3b8' }}>-</span>
                              <div style={{ display: 'flex', flexDirection: 'column', gap: '0.5rem' }}>
                                {descs.map((desc, descIdx) => (
                                  <div
                                    key={descIdx}
                                    style={{
                                      background: desc.color || '#e2e8f0',
                                      color: desc.color === '#FFFF00' || !desc.color ? '#000' : desc.color === '#22c55e' ? '#000' : 'white',
                                      padding: '0.5rem 0.75rem',
                                      borderRadius: '6px',
                                      fontSize: '0.85rem',
                                      fontWeight: '500',
                                      border: desc.color === '#FFFF00' ? '1px solid #000' : 'none',
                                    }}
                                  >
                                    {desc.texto}
                                  </div>
                                ))}
                              </div>
                            )}
                          </td>
                          <td style={{ padding: '1rem', textAlign: 'center', color: '#475569' }}>
                            {event.duracion == 30 ? '30 min' :
                             event.duracion == 60 ? '1 hr' :
                             event.duracion == 120 ? '2 hrs' :
                             event.duracion == 240 ? 'Día completo' :
                             `${event.duracion} min`}
                          </td>
                                                    <td style={{ padding: '1rem', textAlign: 'center' }}>
                            <button
                              onClick={() => handleToggleComplete(event.id, event.completed)}
                              style={{
                                background: event.completed ? '#22c55e' : '#94a3b8',
                                color: 'white',
                                border: 'none',
                                padding: '0.5rem 1rem',
                                borderRadius: '6px',
                                cursor: 'pointer',
                                fontSize: '0.85rem',
                                fontWeight: 'bold',
                              }}
                            >
                              {event.completed ? '✅ Completado' : '⭕ Completar'}
                            </button>
                          </td>
                          {canEdit && (
                            <td style={{ padding: '1rem', textAlign: 'center' }}>
                              <button
                                onClick={() => {
                                  setSelectedEvent(event);
                                  setEditEvent({
                                    titulo: event.titulo,
                                    descripciones: parseDescripciones(event.descripcion),
                                    duracion: event.duracion,
                                  });
                                  setShowEditModal(true);
                                }}
                                style={{
                                  background: '#0066cc',
                                  color: 'white',
                                  border: 'none',
                                  padding: '0.5rem 1rem',
                                  borderRadius: '6px',
                                  cursor: 'pointer',
                                  fontSize: '0.85rem',
                                  fontWeight: 'bold',
                                }}
                              >
                                ✏️ Editar
                              </button>
                            </td>
                          )}
                        </tr>
                      );
                    })
                  )}
                </tbody>
              </table>
            </div>
          </div>
        </div>

        {/* MODAL CREAR EVENTO */}
        {showCreateModal && (
          <div
            style={{
              position: 'fixed',
              inset: 0,
              background: 'rgba(0, 0, 0, 0.5)',
              display: 'flex',
              alignItems: 'center',
              justifyContent: 'center',
              zIndex: 1000,
              padding: '1rem',
            }}
            onClick={() => setShowCreateModal(false)}
          >
            <div
              style={{
                background: 'white',
                borderRadius: '12px',
                padding: '2rem',
                maxWidth: '1000px',
                width: '100%',
                boxShadow: '0 20px 60px rgba(0, 0, 0, 0.3)',
                maxHeight: '90vh',
                overflowY: 'auto',
              }}
              onClick={(e) => e.stopPropagation()}
            >
              <h2 style={{ margin: '0 0 1.5rem 0', color: '#1a365d', fontSize: '1.5rem' }}>
                ➕ Nuevo Evento - {formatDateWithDay(selectedDate)}
              </h2>

              <div style={{ marginBottom: '1.5rem' }}>
                <label style={{ display: 'block', marginBottom: '0.5rem', fontWeight: 'bold', color: '#475569' }}>
                  📝 Título del Evento
                </label>
                <input
                  type="text"
                  placeholder="Título principal"
                  value={newEvent.titulo}
                  onChange={(e) => setNewEvent({ ...newEvent, titulo: e.target.value })}
                  style={{
                    width: '100%',
                    padding: '0.75rem',
                    border: '2px solid #e2e8f0',
                    borderRadius: '8px',
                    fontSize: '1rem',
                    boxSizing: 'border-box',
                  }}
                />
              </div>

              <div style={{ marginBottom: '1.5rem' }}>
                <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: '1rem' }}>
                  <h3 style={{ margin: 0, fontSize: '1rem', fontWeight: 'bold', color: '#1a365d' }}>
                    📌 Descripciones (Puedes agregar varias)
                  </h3>
                  <button
                    onClick={handleAddDescription}
                    style={{
                      background: '#10b981',
                      color: 'white',
                      border: 'none',
                      padding: '0.5rem 1rem',
                      borderRadius: '6px',
                      fontWeight: 'bold',
                      cursor: 'pointer',
                      fontSize: '0.9rem',
                    }}
                  >
                    ➕ Agregar Descripción
                  </button>
                </div>

                <div style={{ display: 'flex', flexDirection: 'column', gap: '1rem' }}>
                  {newEvent.descripciones.length === 0 ? (
                    <div style={{ color: '#94a3b8', fontSize: '0.9rem', textAlign: 'center', padding: '1.5rem', background: '#f0f4f8', borderRadius: '8px' }}>
                      Haz click en "Agregar Descripción" para comenzar
                    </div>
                    newEvent.descripciones.map((desc, idx) => (
                      <div
                        key={idx}
                        style={{
                          background: '#f9fafb',
                          border: '2px solid #e2e8f0',
                          borderRadius: '8px',
                          padding: '1rem',
                        }}
                      >
                        <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: '0.75rem' }}>
                          <span style={{ fontWeight: 'bold', color: '#1a365d' }}>Descripción {idx + 1}</span>
                          <button
                            onClick={() => handleRemoveDescription(idx)}
                            style={{
                              background: '#ef4444',
                              color: 'white',
                              border: 'none',
                              padding: '0.3rem 0.6rem',
                              borderRadius: '4px',
                              cursor: 'pointer',
                              fontSize: '0.75rem',
                              fontWeight: 'bold',
                            }}
                          >
                            ✕ Quitar
                          </button>
                        </div>

                        <textarea
                          placeholder="Texto de la descripción"
                          value={desc.texto}
                          onChange={(e) => handleUpdateDescription(idx, e.target.value, desc.color)}
                          style={{
                            width: '100%',
                            padding: '0.75rem',
                            border: '2px solid #e2e8f0',
                            borderRadius: '6px',
                            fontSize: '0.9rem',
                            boxSizing: 'border-box',
                            fontFamily: 'inherit',
                            minHeight: '80px',
                            resize: 'vertical',
                            marginBottom: '0.75rem',
                          }}
                        ></textarea>

                        <div>
                          <label style={{ display: 'block', marginBottom: '0.5rem', fontSize: '0.85rem', fontWeight: 'bold', color: '#475569' }}>
                            🎨 Color para esta descripción
                          </label>
                          <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fill, minmax(80px, 1fr))', gap: '0.5rem' }}>
                            {COLOR_CODES.map(code => (
                              <button
                                key={code.hex || 'none'}
                                onClick={() => handleUpdateDescription(idx, desc.texto, code.hex)}
                                style={{
                                  width: '100%',
                                  padding: '0.6rem',
                                  background: code.hex || '#e2e8f0',
                                  border: desc.color === code.hex ? '3px solid #000' : '2px solid transparent',
                                  borderRadius: '4px',
                                  cursor: 'pointer',
                                  fontWeight: 'bold',
                                  color: code.hex === '#FFFF00' || !code.hex ? '#000' : code.hex === '#22c55e' ? '#000' : '#fff',
                                  fontSize: '0.7rem',
                                  transition: 'all 0.2s',
                                }}
                                title={code.name}
                              >
                                {code.hex ? '●' : '○'} {code.name}
                              </button>
                            ))}
                          </div>
                        </div>

                        {/* Preview para esta descripción */}
                        <div style={{
                          marginTop: '1rem',
                          background: desc.color || '#e2e8f0',
                          color: desc.color === '#FFFF00' || !desc.color ? '#000' : desc.color === '#22c55e' ? '#000' : 'white',
                          padding: '1rem',
                          borderRadius: '6px',
                          fontSize: '0.9rem',
                          wordBreak: 'break-word',
                          minHeight: '40px',
                          display: 'flex',
                          alignItems: 'center',
                          border: desc.color === '#FFFF00' ? '1px solid #000' : 'none',
                        }}>
                          {desc.texto || '(Vista previa)'}
                        </div>
                      </div>
                    ))
                  )}
                </div>
              </div>

              <div style={{ marginBottom: '1.5rem' }}>
                <label style={{ display: 'block', marginBottom: '0.5rem', fontWeight: 'bold', color: '#475569' }}>
                  ⏱️ Duración
                </label>
                <select
                  value={newEvent.duracion}
                  onChange={(e) => setNewEvent({ ...newEvent, duracion: e.target.value })}
                  style={{
                    width: '100%',
                    padding: '0.75rem',
                    border: '2px solid #e2e8f0',
                    borderRadius: '8px',
                    fontSize: '1rem',
                  }}
                >
                  <option value="30">30 minutos</option>
                  <option value="60">1 hora</option>
                  <option value="120">2 horas</option>
                  <option value="240">Día completo</option>
                </select>
              </div>

              <div style={{ display: 'flex', gap: '1rem' }}>
                <button
                  onClick={handleAddEvent}
                  style={{
                    flex: 1,
                    background: '#0066cc',
                    color: 'white',
                    border: 'none',
                    padding: '0.75rem',
                    borderRadius: '8px',
                    fontWeight: 'bold',
                    fontSize: '1rem',
                    cursor: 'pointer',
                  }}
                >
                  ✅ Guardar Evento
                </button>
                <button
                  onClick={() => setShowCreateModal(false)}
                  style={{
                    flex: 1,
                    background: '#94a3b8',
                    color: 'white',
                    border: 'none',
                    padding: '0.75rem',
                    borderRadius: '8px',
                    fontWeight: 'bold',
                    fontSize: '1rem',
                    cursor: 'pointer',
                  }}
                >
                  ❌ Cancelar
                </button>
              </div>
            </div>
          </div>
        )}

        {/* MODAL EDITAR EVENTO */}
        {showEditModal && selectedEvent && (
          <div
            style={{
              position: 'fixed',
              inset: 0,
              background: 'rgba(0, 0, 0, 0.5)',
              display: 'flex',
              alignItems: 'center',
              justifyContent: 'center',
              zIndex: 1000,
              padding: '1rem',
            }}
            onClick={() => setShowEditModal(false)}
          >
            <div
              style={{
                background: 'white',
                borderRadius: '12px',
                padding: '2rem',
                maxWidth: '1000px',
                width: '100%',
                boxShadow: '0 20px 60px rgba(0, 0, 0, 0.3)',
                maxHeight: '90vh',
                overflowY: 'auto',
              }}
              onClick={(e) => e.stopPropagation()}
            >
              <h2 style={{ margin: '0 0 1.5rem 0', color: '#1a365d', fontSize: '1.5rem' }}>
                ✏️ Editar Evento - {formatDateWithDay(selectedEvent.fechaInicio)}
              </h2>

              <div style={{ marginBottom: '1.5rem' }}>
                <label style={{ display: 'block', marginBottom: '0.5rem', fontWeight: 'bold', color: '#475569' }}>
                  📝 Título del Evento
                </label>
                <input
                  type="text"
                  value={editEvent.titulo}
                  onChange={(e) => setEditEvent({ ...editEvent, titulo: e.target.value })}
                  style={{
                    width: '100%',
                    padding: '0.75rem',
                    border: '2px solid #e2e8f0',
                    borderRadius: '8px',
                    fontSize: '1rem',
                    boxSizing: 'border-box',
                  }}
                />
              </div>

              <div style={{ marginBottom: '1.5rem' }}>
                <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: '1rem' }}>
                  <h3 style={{ margin: 0, fontSize: '1rem', fontWeight: 'bold', color: '#1a365d' }}>
                    📌 Descripciones
                  </h3>
                  <button
                    onClick={handleAddEditDescription}
                    style={{
                      background: '#10b981',
                      color: 'white',
                      border: 'none',
                      padding: '0.5rem 1rem',
                      borderRadius: '6px',
                      fontWeight: 'bold',
                      cursor: 'pointer',
                      fontSize: '0.9rem',
                    }}
                  >
                    ➕ Agregar Descripción
                  </button>
                </div>

                <div style={{ display: 'flex', flexDirection: 'column', gap: '1rem' }}>
                  {editEvent.descripciones.length === 0 ? (
                    <div style={{ color: '#94a3b8', fontSize: '0.9rem', textAlign: 'center', padding: '1.5rem', background: '#f0f4f8', borderRadius: '8px' }}>
                      Haz click en "Agregar Descripción" para comenzar
                    </div>
                    editEvent.descripciones.map((desc, idx) => (
                      <div
                        key={idx}
                        style={{
                          background: '#f9fafb',
                          border: '2px solid #e2e8f0',
                          borderRadius: '8px',
                          padding: '1rem',
                        }}
                      >
                        <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: '0.75rem' }}>
                          <span style={{ fontWeight: 'bold', color: '#1a365d' }}>Descripción {idx + 1}</span>
                          <button
                            onClick={() => handleRemoveEditDescription(idx)}
                            style={{
                              background: '#ef4444',
                              color: 'white',
                              border: 'none',
                              padding: '0.3rem 0.6rem',
                              borderRadius: '4px',
                              cursor: 'pointer',
                              fontSize: '0.75rem',
                              fontWeight: 'bold',
                            }}
                          >
                            ✕ Quitar
                          </button>
                        </div>

                        <textarea
                          value={desc.texto}
                          onChange={(e) => handleEditDescription(idx, e.target.value, desc.color)}
                          style={{
                            width: '100%',
                            padding: '0.75rem',
                            border: '2px solid #e2e8f0',
                            borderRadius: '6px',
                            fontSize: '0.9rem',
                            boxSizing: 'border-box',
                            fontFamily: 'inherit',
                            minHeight: '80px',
                            resize: 'vertical',
                            marginBottom: '0.75rem',
                          }}
                        ></textarea>

                        <div>
                          <label style={{ display: 'block', marginBottom: '0.5rem', fontSize: '0.85rem', fontWeight: 'bold', color: '#475569' }}>
                            🎨 Color para esta descripción
                          </label>
                          <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fill, minmax(80px, 1fr))', gap: '0.5rem' }}>
                            {COLOR_CODES.map(code => (
                              <button
                                key={code.hex || 'none'}
                                onClick={() => handleEditDescription(idx, desc.texto, code.hex)}
                                style={{
                                  width: '100%',
                                  padding: '0.6rem',
                                  background: code.hex || '#e2e8f0',
                                  border: desc.color === code.hex ? '3px solid #000' : '2px solid transparent',
                                  borderRadius: '4px',
                                  cursor: 'pointer',
                                  fontWeight: 'bold',
                                  color: code.hex === '#FFFF00' || !code.hex ? '#000' : code.hex === '#22c55e' ? '#000' : '#fff',
                                  fontSize: '0.7rem',
                                  transition: 'all 0.2s',
                                }}
                                title={code.name}
                              >
                                {code.hex ? '●' : '○'} {code.name}
                              </button>
                            ))}
                          </div>
                        </div>

                        <div style={{
                          marginTop: '1rem',
                          background: desc.color || '#e2e8f0',
                          color: desc.color === '#FFFF00' || !desc.color ? '#000' : desc.color === '#22c55e' ? '#000' : 'white',
                          padding: '1rem',
                          borderRadius: '6px',
                          fontSize: '0.9rem',
                          wordBreak: 'break-word',
                          minHeight: '40px',
                          display: 'flex',
                          alignItems: 'center',
                          border: desc.color === '#FFFF00' ? '1px solid #000' : 'none',
                        }}>
                          {desc.texto || '(Vista previa)'}
                        </div>
                      </div>
                    ))
                  )}
                </div>
              </div>

              <div style={{ marginBottom: '1.5rem' }}>
                <label style={{ display: 'block', marginBottom: '0.5rem', fontWeight: 'bold', color: '#475569' }}>
                  ⏱️ Duración
                </label>
                <select
                  value={editEvent.duracion}
                  onChange={(e) => setEditEvent({ ...editEvent, duracion: e.target.value })}
                  style={{
                    width: '100%',
                    padding: '0.75rem',
                    border: '2px solid #e2e8f0',
                    borderRadius: '8px',
                    fontSize: '1rem',
                  }}
                >
                  <option value="30">30 minutos</option>
                  <option value="60">1 hora</option>
                  <option value="120">2 horas</option>
                  <option value="240">Día completo</option>
                </select>
              </div>

              <div style={{ display: 'flex', gap: '1rem' }}>
                <button
                  onClick={handleEditEvent}
                  style={{
                    flex: 1,
                    background: '#0066cc',
                    color: 'white',
                    border: 'none',
                    padding: '0.75rem',
                    borderRadius: '8px',
                    fontWeight: 'bold',
                    fontSize: '1rem',
                    cursor: 'pointer',
                  }}
                >
                  ✅ Guardar Cambios
                </button>
                <button
                  onClick={() => handleDeleteEvent(selectedEvent.id)}
                  style={{
                    flex: 1,
                    background: '#ef4444',
                    color: 'white',
                    border: 'none',
                    padding: '0.75rem',
                    borderRadius: '8px',
                    fontWeight: 'bold',
                    fontSize: '1rem',
                    cursor: 'pointer',
                  }}
                >
                  🗑️ Eliminar
                </button>
                <button
                  onClick={() => setShowEditModal(false)}
                  style={{
                    flex: 1,
                    background: '#94a3b8',
                    color: 'white',
                    border: 'none',
                    padding: '0.75rem',
                    borderRadius: '8px',
                    fontWeight: 'bold',
                    fontSize: '1rem',
                    cursor: 'pointer',
                  }}
                >
                  ❌ Cerrar
                </button>
              </div>
            </div>
          </div>
        )}
      </main>
    </div>
  );
};

export default Calendar;
