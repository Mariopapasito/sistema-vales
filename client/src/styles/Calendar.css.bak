.calendar-layout {
  padding: 2rem;
}

.calendar-categories {
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(20px);
  padding: 1.5rem;
  border-radius: 16px;
  margin-bottom: 2rem;
  box-shadow: 0 8px 32px rgba(31, 38, 135, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.3);
}

.calendar-categories h3 {
  margin: 0 0 1rem 0;
  color: #1a365d;
  font-size: 1.1rem;
  font-weight: 700;
}

.categories-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 1rem;
}

.category-item {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.75rem;
  background: rgba(240, 249, 255, 0.5);
  backdrop-filter: blur(10px);
  border-radius: 10px;
  border: 1px solid rgba(0, 102, 204, 0.1);
  transition: all 0.3s;
}

.category-item:hover {
  background: rgba(240, 249, 255, 0.8);
  border-color: rgba(0, 102, 204, 0.2);
  transform: translateY(-2px);
}

.color-box {
  width: 30px;
  height: 30px;
  border-radius: 8px;
  border: 2px solid rgba(255, 255, 255, 0.5);
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

.category-info {
  flex: 1;
}

.category-label {
  font-weight: 700;
  color: #1a365d;
  font-size: 0.85rem;
}

.category-desc {
  font-size: 0.75rem;
  color: #64748b;
  margin-top: 0.125rem;
}

.calendar-month-header {
  text-align: center;
  margin: 1.5rem 0;
  padding: 1.5rem;
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(20px);
  border-radius: 16px;
  border: 1px solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 8px 32px rgba(31, 38, 135, 0.1);
}

.calendar-month-header h2 {
  margin: 0 0 1rem 0;
  font-size: 1.8rem;
  color: #1a365d;
  font-weight: 800;
}

.month-nav {
  display: flex;
  justify-content: center;
  gap: 0.75rem;
}

.month-nav button {
  padding: 0.5rem 1rem;
  background: linear-gradient(135deg, rgba(0, 102, 204, 0.6) 0%, rgba(0, 82, 163, 0.6) 100%);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.3);
  color: white;
  border-radius: 8px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s;
}

.month-nav button:hover {
  background: linear-gradient(135deg, rgba(0, 102, 204, 0.8) 0%, rgba(0, 82, 163, 0.8) 100%);
  transform: translateY(-2px);
}

.calendar-grid {
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(20px);
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 8px 32px rgba(31, 38, 135, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.3);
}

.calendar-header {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  background: linear-gradient(135deg, rgba(0, 102, 204, 0.8) 0%, rgba(0, 82, 163, 0.8) 100%);
  backdrop-filter: blur(10px);
  color: white;
  font-weight: 700;
  text-align: center;
  padding: 1rem;
  gap: 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.2);
}

.calendar-header div {
  padding: 0.75rem;
  font-size: 0.9rem;
}

.calendar-week {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 1px;
  background: rgba(0, 102, 204, 0.05);
  padding: 1px;
}

.calendar-day {
  background: rgba(255, 255, 255, 0.8);
  min-height: 120px;
  padding: 0.75rem;
  border-radius: 8px;
  cursor: pointer;
  transition: all 0.3s;
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.calendar-day:hover {
  background: rgba(240, 249, 255, 0.9);
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(0, 102, 204, 0.15);
}

.calendar-day.other-month {
  background: rgba(240, 249, 255, 0.3);
  color: #94a3b8;
}

.calendar-day-number {
  font-weight: 700;
  color: #1a365d;
  font-size: 0.9rem;
}

.calendar-events {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  flex: 1;
}

.calendar-event {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.4rem 0.5rem;
  background: linear-gradient(135deg, rgba(0, 102, 204, 0.7) 0%, rgba(0, 82, 163, 0.7) 100%);
  backdrop-filter: blur(10px);
  color: white;
  border-radius: 6px;
  font-size: 0.75rem;
  border: 1px solid rgba(255, 255, 255, 0.2);
  box-shadow: 0 2px 8px rgba(0, 102, 204, 0.2);
  cursor: pointer;
  transition: all 0.3s;
}

.calendar-event:hover {
  transform: translateX(2px);
  box-shadow: 0 4px 12px rgba(0, 102, 204, 0.3);
}

.calendar-event.red {
  background: linear-gradient(135deg, rgba(220, 38, 38, 0.7) 0%, rgba(185, 28, 28, 0.7) 100%);
  border-color: rgba(220, 38, 38, 0.3);
}

.calendar-event.orange {
  background: linear-gradient(135deg, rgba(251, 146, 60, 0.7) 0%, rgba(234, 88, 12, 0.7) 100%);
  border-color: rgba(251, 146, 60, 0.3);
}

.calendar-event.green {
  background: linear-gradient(135deg, rgba(34, 197, 94, 0.7) 0%, rgba(22, 163, 74, 0.7) 100%);
  border-color: rgba(34, 197, 94, 0.3);
}

.calendar-event.purple {
  background: linear-gradient(135deg, rgba(168, 85, 247, 0.7) 0%, rgba(126, 34, 206, 0.7) 100%);
  border-color: rgba(168, 85, 247, 0.3);
}

.calendar-event.yellow {
  background: linear-gradient(135deg, rgba(234, 179, 8, 0.7) 0%, rgba(202, 138, 4, 0.7) 100%);
  border-color: rgba(234, 179, 8, 0.3);
  color: white;
}

.calendar-event-text {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.calendar-event-delete {
  background: none;
  border: none;
  color: white;
  cursor: pointer;
  font-size: 1rem;
  padding: 0;
  margin: 0;
  transition: all 0.2s;
}

.calendar-event-delete:hover {
  transform: scale(1.3);
}

/* Modal */
.event-modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(5px);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
}

.event-modal-content {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20px);
  border-radius: 20px;
  padding: 2rem;
  max-width: 500px;
  width: 90%;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);
  border: 1px solid rgba(255, 255, 255, 0.5);
  position: relative;
}

.event-modal-close {
  position: absolute;
  top: 1rem;
  right: 1rem;
  background: rgba(255, 255, 255, 0.5);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  color: #64748b;
  transition: all 0.3s;
  font-size: 1.5rem;
}

.event-modal-close:hover {
  color: #1a365d;
  background: rgba(255, 255, 255, 0.7);
  transform: rotate(90deg);
}

.event-modal-content h2 {
  margin: 0 0 1.5rem;
  color: #1a365d;
  font-size: 1.5rem;
  font-weight: 800;
}

.form-group {
  margin-bottom: 1.25rem;
}

.form-group label {
  display: block;
  font-weight: 700;
  color: #1a365d;
  margin-bottom: 0.5rem;
  font-size: 0.95rem;
}

.form-group input,
.form-group textarea {
  width: 100%;
  padding: 0.75rem;
  background: rgba(255, 255, 255, 0.5);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(0, 102, 204, 0.2);
  border-radius: 10px;
  font-size: 1rem;
  color: #1a365d;
  transition: all 0.3s;
}

.form-group input:focus,
.form-group textarea:focus {
  outline: none;
  background: rgba(255, 255, 255, 0.8);
  border-color: rgba(0, 102, 204, 0.4);
  box-shadow: 0 0 0 3px rgba(0, 102, 204, 0.1);
}

.form-group textarea {
  resize: vertical;
  min-height: 80px;
}

.color-selector {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 0.75rem;
}

.color-option {
  width: 100%;
  aspect-ratio: 1;
  border-radius: 10px;
  border: 2px solid rgba(255, 255, 255, 0.3);
  cursor: pointer;
  transition: all 0.3s;
  position: relative;
}

.color-option:hover {
  transform: scale(1.05);
  border-color: rgba(255, 255, 255, 0.6);
}

.color-option.selected::after {
  content: '✓';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  color: white;
  font-size: 1.25rem;
  font-weight: 700;
}

.preview-box {
  padding: 1rem;
  background: rgba(240, 249, 255, 0.5);
  backdrop-filter: blur(10px);
  border-radius: 10px;
  border: 1px solid rgba(0, 102, 204, 0.1);
  margin-bottom: 1.25rem;
}

.preview-box h4 {
  margin: 0 0 0.75rem;
  color: #64748b;
  font-size: 0.85rem;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.preview-event {
  padding: 0.75rem;
  border-radius: 8px;
  color: white;
  font-weight: 600;
  min-height: 40px;
  display: flex;
  align-items: center;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

.event-modal-buttons {
  display: flex;
  gap: 0.75rem;
  margin-top: 1.5rem;
}

.event-modal-buttons button {
  flex: 1;
  padding: 0.75rem;
  border: none;
  border-radius: 10px;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.3s;
}

.event-modal-buttons .btn-save {
  background: linear-gradient(135deg, rgba(0, 102, 204, 0.8) 0%, rgba(0, 82, 163, 0.8) 100%);
  backdrop-filter: blur(10px);
  color: white;
  border: 1px solid rgba(255, 255, 255, 0.2);
}

.event-modal-buttons .btn-save:hover {
  background: linear-gradient(135deg, rgba(0, 102, 204, 1) 0%, rgba(0, 82, 163, 1) 100%);
  transform: translateY(-2px);
}

.event-modal-buttons .btn-cancel {
  background: rgba(255, 255, 255, 0.5);
  backdrop-filter: blur(10px);
  color: #1a365d;
  border: 1px solid rgba(0, 102, 204, 0.2);
}

.event-modal-buttons .btn-cancel:hover {
  background: rgba(255, 255, 255, 0.7);
  border-color: rgba(0, 102, 204, 0.4);
}

@media (max-width: 768px) {
  .calendar-layout {
    padding: 1rem;
  }

  .calendar-day {
    min-height: 100px;
  }

  .categories-grid {
    grid-template-columns: 1fr;
  }
}

.calendar-weekdays {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8px;
  margin-bottom: 8px;
  padding: 0 1rem;
}

.weekday {
  text-align: center;
  font-weight: 700;
  color: #0066cc;
  padding: 12px;
  font-size: 0.9rem;
  text-transform: uppercase;
}

.calendar-days {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8px;
  padding: 1rem;
  margin-top: 1rem;
}

.calendar-day {
  background: rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(0, 102, 204, 0.2);
  border-radius: 12px;
  padding: 12px;
  min-height: 100px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  position: relative;
  transition: all 0.3s ease;
}

.calendar-day:hover {
  background: rgba(255, 255, 255, 0.8);
  border-color: rgba(0, 102, 204, 0.4);
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(0, 102, 204, 0.15);
}

.calendar-day.empty {
  background: rgba(240, 249, 255, 0.3);
  border: none;
  pointer-events: none;
}

.day-number {
  font-weight: 700;
  color: #0066cc;
  font-size: 0.95rem;
  margin-bottom: 4px;
}

.events-container {
  display: flex;
  flex-direction: column;
  gap: 4px;
  flex: 1;
}

.event-item {
  background: rgba(0, 102, 204, 0.7);
  color: white;
  padding: 6px 8px;
  border-radius: 6px;
  font-size: 0.75rem;
  cursor: pointer;
  transition: all 0.2s;
  position: relative;
  display: flex;
  align-items: center;
  gap: 4px;
}

.event-item:hover {
  opacity: 0.9;
  transform: scale(1.02);
}

.event-text {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-weight: 600;
}

.event-delete {
  background: transparent;
  border: none;
  color: white;
  cursor: pointer;
  padding: 0 4px;
  font-size: 0.8rem;
  opacity: 0;
  transition: opacity 0.2s;
}

.event-item:hover .event-delete {
  opacity: 1;
}

.add-event-btn {
  background: rgba(0, 102, 204, 0.5);
  border: 2px dashed rgba(0, 102, 204, 0.5);
  color: #0066cc;
  border-radius: 6px;
  padding: 4px;
  cursor: pointer;
  font-weight: 700;
  transition: all 0.2s;
}

.add-event-btn:hover {
  background: rgba(0, 102, 204, 0.7);
  border-color: rgba(0, 102, 204, 0.7);
  color: white;
}

/* Event checkbox styling */
.event-checkbox {
  cursor: pointer;
  width: 16px;
  height: 16px;
  margin: 0;
  padding: 0;
  accent-color: #2ecc71;
}

.event-item.completed {
  opacity: 0.6;
}

.event-item.completed .event-title span {
  text-decoration: line-through;
  color: rgba(0, 0, 0, 0.5);
}

.event-title {
  display: flex;
  align-items: center;
  gap: 6px;
  font-weight: 600;
  font-size: 0.85rem;
}

.event-desc {
  display: block;
  margin-top: 2px;
  opacity: 0.75;
  font-size: 0.75rem;
}

/* Calendar controls styling */
.calendar-controls {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
  gap: 20px;
}

.btn-nav {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border: none;
  padding: 8px 16px;
  border-radius: 6px;
  cursor: pointer;
  font-weight: 600;
  transition: all 0.3s ease;
}

.btn-nav:hover {
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
}

.current-month {
  font-size: 1.3rem;
  color: #333;
  text-transform: capitalize;
  flex: 1;
  text-align: center;
}

/* Day structure */
.calendar-day {
  min-height: 100px;
  border: 1px solid #e0e0e0;
  border-radius: 6px;
  padding: 8px;
  background: #f9f9f9;
  cursor: pointer;
  transition: all 0.2s ease;
  display: flex;
  flex-direction: column;
}

.calendar-day:hover {
  background: #f0f0f0;
  border-color: #667eea;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

.calendar-day.empty {
  background: transparent;
  border: none;
  cursor: default;
  pointer-events: none;
}

.day-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6px;
  padding-bottom: 6px;
  border-bottom: 1px solid #ddd;
}

.day-number {
  font-weight: 700;
  font-size: 1rem;
  color: #333;
}

.day-name {
  font-size: 0.75rem;
  color: #666;
  text-transform: uppercase;
  font-weight: 600;
}

.day-events {
  display: flex;
  flex-direction: column;
  gap: 4px;
  flex: 1;
  overflow-y: auto;
}
