.users-layout {
  display: flex;
  height: 100vh;
  background: linear-gradient(135deg, #f0f7ff 0%, #f5fbff 50%, #e8f4ff 100%);
  position: relative;
}

.users-main {
  flex: 1;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
}

.users-container {
  
  margin: 0 auto;
  width: 100%;
  padding: 2rem;
}

.users-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 2rem;
  gap: 1rem;
}

.users-header h1 {
  font-size: 2.5rem;
  color: #1a365d;
  margin: 0 0 0.5rem;
  font-weight: 800;
  letter-spacing: -0.5px;
}

.subtitle {
  color: #64748b;
  margin: 0;
  font-size: 1rem;
  font-weight: 500;
}

.btn-create-user {
  padding: 0.85rem 1.5rem;
  background: linear-gradient(135deg, rgba(34, 197, 94, 0.8) 0%, rgba(22, 163, 74, 0.8) 100%);
  backdrop-filter: blur(10px);
  color: white;
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 12px;
  cursor: pointer;
  font-weight: 700;
  transition: all 0.3s;
  white-space: nowrap;
  box-shadow: 0 8px 32px rgba(34, 197, 94, 0.15);
}

.btn-create-user:hover {
  background: linear-gradient(135deg, rgba(34, 197, 94, 1) 0%, rgba(22, 163, 74, 1) 100%);
  transform: translateY(-2px);
  box-shadow: 0 12px 40px rgba(34, 197, 94, 0.25);
}

.loading,
.empty-state,
.access-denied {
  text-align: center;
  padding: 3rem 1rem;
  color: #94a3b8;
  font-size: 1.1rem;
}

.access-denied {
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(20px);
  border-radius: 16px;
  box-shadow: 0 8px 32px rgba(31, 38, 135, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.3);
  padding: 4rem 2rem;
}

.access-denied h2 {
  color: #1a365d;
  font-size: 1.5rem;
  margin: 0 0 1rem;
}

.access-denied p {
  color: #64748b;
  margin: 0;
}

.users-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 1.5rem;
}

.user-card {
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(20px);
  border-radius: 16px;
  padding: 1.5rem;
  box-shadow: 0 8px 32px rgba(31, 38, 135, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.3);
  transition: all 0.3s;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.user-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 12px 40px rgba(31, 38, 135, 0.2);
  border-color: rgba(0, 102, 204, 0.3);
}

.user-avatar-large {
  width: 80px;
  height: 80px;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(0, 102, 204, 0.8) 0%, rgba(0, 82, 163, 0.8) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 2rem;
  font-weight: 700;
  overflow: hidden;
  border: 3px solid rgba(255, 255, 255, 0.5);
  box-shadow: 0 4px 12px rgba(0, 102, 204, 0.2);
  margin-bottom: 1rem;
}

.user-avatar-large img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.user-card-content {
  flex: 1;
  width: 100%;
}

.user-card-content h3 {
  margin: 0 0 0.25rem;
  color: #1a365d;
  font-size: 1.1rem;
  font-weight: 700;
}

.user-email {
  color: #64748b;
  margin: 0 0 1rem;
  font-size: 0.9rem;
}

.user-info {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  margin-bottom: 1.25rem;
  padding: 1rem 0;
  border-top: 1px solid rgba(0, 102, 204, 0.1);
  border-bottom: 1px solid rgba(0, 102, 204, 0.1);
}

.info-item {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 0.5rem;
}

.info-item .label {
  font-weight: 700;
  color: #64748b;
  font-size: 0.85rem;
}

.info-item .value {
  color: #1a365d;
  font-weight: 600;
}

.role-badge {
  color: white;
  padding: 0.25rem 0.75rem;
  border-radius: 20px;
  font-size: 0.75rem;
  font-weight: 700;
}

.user-card-actions {
  display: flex;
  gap: 0.75rem;
  width: 100%;
}

.btn-edit,
.btn-delete {
  flex: 1;
  padding: 0.6rem;
  border: none;
  border-radius: 8px;
  cursor: pointer;
  font-weight: 600;
  font-size: 0.85rem;
  transition: all 0.3s;
}

.btn-edit {
  background: linear-gradient(135deg, rgba(0, 102, 204, 0.7) 0%, rgba(0, 82, 163, 0.7) 100%);
  backdrop-filter: blur(10px);
  color: white;
  border: 1px solid rgba(255, 255, 255, 0.2);
}

.btn-edit:hover {
  background: linear-gradient(135deg, rgba(0, 102, 204, 1) 0%, rgba(0, 82, 163, 1) 100%);
  transform: translateY(-2px);
}

.btn-delete {
  background: linear-gradient(135deg, rgba(220, 38, 38, 0.7) 0%, rgba(185, 28, 28, 0.7) 100%);
  backdrop-filter: blur(10px);
  color: white;
  border: 1px solid rgba(255, 255, 255, 0.2);
}

.btn-delete:hover {
  background: linear-gradient(135deg, rgba(220, 38, 38, 1) 0%, rgba(185, 28, 28, 1) 100%);
  transform: translateY(-2px);
}

/* Modal */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.3);
  backdrop-filter: blur(4px);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
}

.modal-content {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20px);
  border-radius: 20px;
  padding: 2.5rem;
  max-width: 500px;
  width: 90%;
  max-height: 90vh;
  overflow-y: auto;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);
  border: 1px solid rgba(255, 255, 255, 0.5);
  position: relative;
}

.modal-close {
  position: absolute;
  top: 1.5rem;
  right: 1.5rem;
  background: rgba(255, 255, 255, 0.5);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.3);
  font-size: 1.5rem;
  cursor: pointer;
  color: #64748b;
  width: 40px;
  height: 40px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
}

.modal-close:hover {
  color: #1a365d;
  background: rgba(255, 255, 255, 0.7);
  transform: rotate(90deg);
}

.modal-content h2 {
  margin: 0 0 1.5rem;
  color: #1a365d;
  font-size: 1.8rem;
  font-weight: 700;
}

.user-form {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.form-group label {
  font-weight: 700;
  color: #1a365d;
  font-size: 0.95rem;
}

.form-group input,
.form-group select {
  padding: 0.75rem;
  background: rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(0, 102, 204, 0.2);
  border-radius: 10px;
  font-size: 1rem;
  color: #1a365d;
  transition: all 0.3s;
}

.form-group input:focus,
.form-group select:focus {
  outline: none;
  background: rgba(255, 255, 255, 0.8);
  border-color: rgba(0, 102, 204, 0.4);
  box-shadow: 0 0 0 3px rgba(0, 102, 204, 0.1);
}

.form-actions {
  display: flex;
  gap: 1rem;
  margin-top: 1.5rem;
}

.btn-save {
  flex: 1;
  padding: 0.85rem;
  background: linear-gradient(135deg, rgba(34, 197, 94, 0.8) 0%, rgba(22, 163, 74, 0.8) 100%);
  backdrop-filter: blur(10px);
  color: white;
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 10px;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.3s;
}

.btn-save:hover {
  background: linear-gradient(135deg, rgba(34, 197, 94, 1) 0%, rgba(22, 163, 74, 1) 100%);
  transform: translateY(-2px);
}

.btn-cancel {
  flex: 1;
  padding: 0.85rem;
  background: rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(10px);
  color: #1a365d;
  border: 1px solid rgba(0, 102, 204, 0.2);
  border-radius: 10px;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.3s;
}

.btn-cancel:hover {
  background: rgba(255, 255, 255, 0.8);
  border-color: rgba(0, 102, 204, 0.4);
}

@media (max-width: 768px) {
  .users-container {
    padding: 1rem;
  }

  .users-header {
    flex-direction: column;
    align-items: flex-start;
  }

  .users-grid {
    grid-template-columns: 1fr;
  }

  .modal-content {
    padding: 1.5rem;
  }
}